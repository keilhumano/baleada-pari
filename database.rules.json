{
  "rules": {
    "entries": {
      ".read": true,
      ".write": true,
      "$entry": {
        ".validate": "!newData.exists() || newData.hasChildren(['name', 'source', 'order'])",
        "name":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
        "source": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "order":  { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
